<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Gaurav Online Store</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f3f6;
}

header {
    background: #131921;
    color: white;
    padding: 20px;
    text-align: center;
}

header h1 {
    margin: 0;
}

header p {
    margin-bottom: 0;
    color: #ddd;
}

.offer {
    background: #fff;
    padding: 18px;
    text-align: center;
    margin: 15px;
    border-radius: 10px;
}

.offer h2 {
    color: #e53935;
    margin: 5px;
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    padding: 15px;
}

.product {
    background: white;
    padding: 12px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 2px 8px #ddd;
}

.product img {
    width: 100%;
    height: 260px;
    object-fit: contain;
    border-radius: 8px;
}

.product h3 {
    font-size: 18px;
}

.old-price {
    color: #777;
    text-decoration: line-through;
    font-size: 16px;
}

.price {
    color: #138808;
    font-size: 25px;
    font-weight: bold;
}

.buy {
    display: block;
    background: #ff9900;
    color: #111;
    padding: 13px;
    margin-top: 12px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
}

.buy:hover {
    background: #e68a00;
}

footer {
    background: #131921;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (max-width: 600px) {
    .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        padding: 10px;
    }

    .product {
        padding: 8px;
    }

    .product img {
        height: 180px;
    }

    .product h3 {
        font-size: 15px;
    }

    .price {
        font-size: 22px;
    }
}
</style>
</head>

<body>

<header>
    <h1>Gaurav Online Store</h1>
    <p>Fashion T-Shirts | Best Price</p>
</header>

<div class="offer">
    <h2>Special Sale Offer!</h2>
    <p>सभी T-Shirts सिर्फ ₹400 में</p>
    <p>Original Price ₹500 | बचाएं ₹100</p>
</div>

<div class="products">

    <!-- T-Shirt 1 -->
    <div class="product">
        <a href="https://docs.google.com/forms/d/1-QqKROhqY8aeJUCPiS7faldSX-SFgCdwvTrjULe7OZ0/edit?pli=1"
           target="_blank">
            <img src="images.jpg" alt="Maroon Discover T-Shirt">
        </a>

        <h3>Maroon Discover T-Shirt</h3>

        <p class="old-price">₹500</p>
        <p class="price">₹400</p>

        <a class="buy"
           href="https://docs.google.com/forms/d/1-QqKROhqY8aeJUCPiS7faldSX-SFgCdwvTrjULe7OZ0/edit?pli=1"
           target="_blank">
            Buy Now
        </a>
    </div>


    <!-- T-Shirt 2 -->
    <div class="product">
        <a href="https://docs.google.com/forms/d/1-QqKROhqY8aeJUCPiS7faldSX-SFgCdwvTrjULe7OZ0/edit?pli=1"
           target="_blank">
            <img src="xl-858-culture-magneto-original-imahhfhyk8jzzfth.webp"
                 alt="Black Culture T-Shirt">
        </a>

        <h3>Black Culture T-Shirt</h3>

        <p class="old-price">₹500</p>
        <p class="price">₹400</p>

        <a class="buy"
           href="https://docs.google.com/forms/d/1-QqKROhqY8aeJUCPiS7faldSX-SFgCdwvTrjULe7OZ0/edit?pli=1"
           target="_blank">
            Buy Now
        </a>
    </div>


    <!-- T-Shirt 3 -->
    <div class="product">
        <a href="https://docs.google.com/forms/d/1-QqKROhqY8aeJUCPiS7faldSX-SFgCdwvTrjULe7OZ0/edit?pli=1"
           target="_blank">
            <img src="images%20(1).jpg" alt="Black Attitude T-Shirt">
        </a>

        <h3>Black Attitude T-Shirt</h3>

        <p class="old-price">₹500</p>
        <p class="price">₹400</p>

        <a class="buy"
           href="https://docs.google.com/forms/d/1-QqKROhqY8aeJUCPiS7faldSX-SFgCdwvTrjULe7OZ0/edit?pli=1"
           target="_blank">
            Buy Now
        </a>
    </div>

</div>

<footer>
    <p>Gaurav Online Store</p>
    <p>Thank You For Shopping!</p>
</footer>

</body>
</html>
